# Copy to .env.<name> (gitignored), fill it in, then from this folder:
#   ./deploy.sh .env.<name> [logs|lag|promote|down]

# ---- Name --------------------------------------------------------------------
# The deploy is <RELEASE>-pgbackrest-restore in NAMESPACE.
RELEASE=db
NAMESPACE=default

# ---- Image -------------------------------------------------------------------
# The same image the source database runs:
#   kubectl get sts <release>-web-db -o jsonpath='{.spec.template.spec.containers[0].image}'
IMAGE=ghcr.io/osm-seed/db:

# ---- Source: the pgBackRest repo ----------------------------------------------
# webDb.pgbackrest.s3Bucket and s3Path in the source's values.
S3_BUCKET=
S3_PATH=/database/web-db-pgbackrest
# READ-ONLY keys on that path.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# webDb.pgbackrest.cipherPass. Empty if the repo is not encrypted.
CIPHER_PASS=

# ---- What to restore ---------------------------------------------------------
#   TARGET_TYPE  TARGET_TIME   result
#   (empty)      (empty)       latest WAL, then a normal database
#   (empty)      a time        that minute, then a normal database
#   standby      (empty)       follows the source until ./deploy.sh ... promote
TARGET_TYPE=
TARGET_TIME=                        # e.g. "2026-09-30 22:30:00+00", with the zone
# true: reuse the files already in HOST_PATH and download only what differs.
RESTORE_DELTA=

# ---- Postgres ----------------------------------------------------------------
# Comma separated. A standby needs at least the source's values, or it stops.
PG_SETTINGS=max_connections=200,max_worker_processes=2
# Role used by lag and promote.
PG_USER=postgres
# promote sets this as PG_USER's password, so the copy stops using the source's.
# e.g. openssl rand -hex 24. Empty: keep the source's password.
NEW_DB_PASSWORD=

# ---- Storage -----------------------------------------------------------------
CLOUD_PROVIDER=k3s                  # k3s | aws
# k3s: folder on the node. Convention: /mnt/restore/<component>-<env>-<date>
HOST_PATH=/mnt/restore/web-db-production-20260930-2230
# aws only: an existing EBS volume, or a new one in STORAGE_CLASS.
EBS_VOLUME_ID=
STORAGE_CLASS=                      # e.g. gp3
STORAGE_SIZE=300Gi

# ---- Node --------------------------------------------------------------------
# With HOST_PATH, pin one node: the data only exists there.
# e.g. kubernetes.io/hostname=ohm-staging-worker-01
NODE_SELECTOR=
