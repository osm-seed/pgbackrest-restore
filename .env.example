# cp .env.example .env.prod, fill it in, then: ./deploy.sh .env.prod
RELEASE=prod-1800
NAMESPACE=restore-test

# The full image the source database runs:
#   kubectl get sts <release>-web-db -o jsonpath='{.spec.template.spec.containers[0].image}'
IMAGE=ghcr.io/osm-seed/db:

# The pgBackRest repo: webDb.pgbackrest.s3Bucket and s3Path in your values.
S3_BUCKET=
S3_PATH=/database/web-db-pgbackrest
# READ-ONLY keys on that path.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# webDb.pgbackrest.cipherPass. Empty if not encrypted.
CIPHER_PASS=

# With the zone. Empty: latest backup plus every WAL.
TARGET_TIME="2026-09-30 18:00:00+00"

# Where the restored database lives, as in osm-seed. A new one per restore.
CLOUD_PROVIDER=k3s                  # k3s | aws
# k3s: a folder on the node. Empty: a local-path PVC of STORAGE_SIZE.
HOST_PATH=/mnt/restore-prod-2230
# aws: an existing EBS volume. Empty: a new one of STORAGE_SIZE in STORAGE_CLASS.
EBS_VOLUME_ID=
STORAGE_CLASS=                      # e.g. gp3
STORAGE_SIZE=300Gi

# Node to run on, key=value. With HOST_PATH, pin one node: the folder is there.
NODE_SELECTOR=kubernetes.io/hostname=ohm-staging-worker-01
